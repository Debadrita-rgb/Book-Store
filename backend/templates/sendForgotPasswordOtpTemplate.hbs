<div
  style="
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    padding: 30px 20px;
  "
>
  <div
    style="
      max-width: 500px;
      margin: auto;
      background: #ffffff;
      border-radius: 12px;
      padding: 30px;
      text-align: center;
      box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    "
  >
    <div style="text-align:center; margin-bottom:20px;">
      <img
        src="https://show-hub-frontend.onrender.com/assets/admin_login_logo-CDHIE2pX.png"
        width="80"
        alt="BookStore"
      />
    </div>

    <h2 style="margin-bottom:10px; color:#222;">
      Password Reset
    </h2>

    <p style="color:#555;">
      Hello <b>{{name}}</b>,
    </p>

    <p style="color:#555;">
      Use the following OTP to reset your BookStore password:
    </p>

    <div
      style="
        margin: 25px 0;
        padding: 18px;
        background: #f5f3ff;
        border-radius: 10px;
      "
    >
      <div
        style="
          font-size: 36px;
          font-weight: bold;
          letter-spacing: 8px;
          color: #4f46e5;
        "
      >
        {{otp}}
      </div>
    </div>

    <p style="font-size:14px; color:#777;">
      This OTP will expire in <b>5 minutes</b>.
    </p>

    <p style="font-size:12px; color:#aaa; margin-top:25px;">
      If you didn't request a password reset, you can safely ignore this
      email.
    </p>

    <p
      style="
        font-size:12px;
        color:#aaa;
        margin-top:25px;
        border-top:1px solid #eee;
        padding-top:15px;
      "
    >
      © {{year}} BookStore. All rights reserved.
    </p>
  </div>
</div>